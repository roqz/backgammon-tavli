# Copy to deploy/.env and fill in. docker compose reads it automatically.

# Domain pointing to this server (A/AAAA record). Caddy gets the HTTPS certificate itself.
# Empty: plain HTTP on port 80 (only for a first test; push notifications need HTTPS).
DOMAIN=tavli.example.com

# Contact for the browser push services (mailto: or https: URL).
VAPID_SUBJECT=mailto:admin@example.com

# Moderation API (reports, bans). Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Imprint and privacy notice (shown in the app).
OPERATOR_NAME=
# Street and city separated by "|", e.g. "Musterstraße 1|12345 Musterstadt"
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
# Hosting provider named in the privacy notice, e.g. "Hetzner Online GmbH, Gunzenhausen"
HOSTING=

# Optional
# SPECTATOR_DELAY_SECONDS=0
# TOURNAMENT_SPECTATOR_DELAY_SECONDS=60
# BACKUP_KEEP=14
# HTTP_PORT=80
# HTTPS_PORT=443
