# DOMAIN=tavli.example.com gives automatic HTTPS (Let's Encrypt); compose defaults to ":80" (plain HTTP).
{$DOMAIN} {
	encode zstd gzip

	# Security headers. connect-src 'self' covers the same-origin WebSocket; the push service is
	# contacted by the browser itself, not by the page. HSTS is only sent over HTTPS (DOMAIN set).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"

	handle /api/* {
		reverse_proxy server:2567
	}
	handle /ws {
		reverse_proxy server:2567
	}
	handle {
		root * /srv
		try_files {path} /index.html
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /sw.js Cache-Control "no-cache"
		header /push-sw.js Cache-Control "no-cache"
		header /registerSW.js Cache-Control "no-cache"
		file_server
	}
}
